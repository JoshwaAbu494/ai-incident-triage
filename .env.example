# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=
# Model used by all three agents.
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/incident_triage
