@'
# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=GROQ_API_KEY_REDACTED

# Model used by all three agents. llama-3.3-70b-versatile is a strong,
# free-tier-friendly default. See console.groq.com for other options.
GROQ_MODEL=llama-3.3-70b-versatile
'@ | Set-Content -Path ".env.example" -Encoding utf8