# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model used by all three agents.
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API key — used only for embeddings (Groq doesn't offer
# a public embeddings API). Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
